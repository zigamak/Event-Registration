# .env file - Store sensitive environment variables here
# This file should NOT be committed to version control (e.g., Git)

# Database Credentials
DB_HOST="localhost"
DB_NAME="event_registration"
DB_USER="root"
DB_PASS=""

# Google Sheets API Credentials
# Path to your Google Service Account JSON key file
# Make sure this file is NOT publicly accessible
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=credentials.json

# The ID of your Google Sheet (from its URL, e.g., https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit)
GOOGLE_SHEET_ID=1KLKLCQGbGyMnJ07YRwFoMK2kWaCEzrA8HbORREcTwC8

# The range to append data to (e.g., 'Sheet1!A:G' or 'Registrations!A:G')
GOOGLE_SHEET_RANGE=Registrations!A:G

# Paystack API Credentials
# Get these from your Paystack Dashboard (Settings -> API Keys & Webhooks)
PAYSTACK_PUBLIC_KEY=pk_test_bf167a8a82a4c776b4c98ce6ca4eb901f4d0db37
PAYSTACK_SECRET_KEY=sk_test_30f5228eb1491659e11c1871bf1a5ead994fe450

# Paystack Subaccount IDs for splitting
# Create these in your Paystack Dashboard -> Transfers -> Subaccounts
# These are example placeholders; replace with your actual subaccount codes.
PAYSTACK_PLATFORM_SUBACCOUNT_CODE=ACCT_YOURPLATFORMSUBACCOUNTCODE
PAYSTACK_PARTNER_SUBACCOUNT_CODE=ACCT_YOURPARTNERSUBACCOUNTCODE
